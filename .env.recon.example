# Example config for scripts/recon-motoacquire.ts.
# Copy to .env.recon (git-ignored) and fill in real values.
#
# This script runs from your personal machine, NOT from the Lovable
# build environment — egress is blocked there.

# Target landing page. Default: https://sellyourcar.online. Override with a
# specific dealer or creator subdomain when one is known, e.g.
#   https://sellyourcar.online/porschedetroitnorth
TARGET_URL=https://sellyourcar.online

# Identify the vehicle by VIN OR by plate+state. VIN is preferred.
# Use a vehicle you actually own — do not fabricate.
SAMPLE_VIN=
SAMPLE_PLATE=
SAMPLE_STATE=

SAMPLE_ZIP=06810
SAMPLE_MILEAGE=62500

# Set HEADFUL=1 to watch the run in a visible browser window. Useful the
# first time you run it, or when selectors stop matching.
HEADFUL=0
