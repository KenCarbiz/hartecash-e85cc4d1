# Copy this file to .env.screenshot and fill in the values.
# .env.screenshot is git-ignored — never commit real credentials.

# REQUIRED — the target HarteCash deployment to screenshot.
# Production:  https://hartecash.com
# Staging:     a Lovable preview URL from the branch you want to capture
# Local:       http://localhost:8080
BASE_URL=https://hartecash.com

# OPTIONAL — admin login. Skip to capture only the public customer journey.
# Use a dedicated screenshot-only admin account if possible — the script
# logs in via the standard /auth form, no service-role key needed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# OPTIONAL — submission token to use for /portal/<token> and /offer/<token>.
# Pick a stable demo submission so screenshots stay reproducible across runs.
# See DEMO_MODE.md for setting up a demo submission.
DEMO_TOKEN=

# OPTIONAL — which viewports to capture. "desktop", "mobile", or "both".
VIEWPORTS=both
